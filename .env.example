# Server
NODE_ENV=development
PORT=3000
SITE_URL=https://watsonstoronto.com

# Public client/API settings
# Safe to expose in browser code when prefixed with VITE_.
VITE_PUBLIC_API_BASE_URL=/api

# MongoDB
# Keep real credentials in .env locally and Heroku config vars in production.
MONGODB_URI=
MONGODB_DB_NAME=watsons

# Admin dashboard
# Bootstrap owner email(s). After first sign-in, admin users live in MongoDB.
ADMIN_EMAILS=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_MAX_AGE_SECONDS=28800
ADMIN_OTP_EXPIRES_SECONDS=59
ADMIN_RESTAURANT_SLUG=watsons
ADMIN_MENU_SLUG=liquor

# SMTP is required for production admin OTP delivery.
# For Gmail, use a Google App Password, not the normal Gmail password.
ADMIN_OTP_FROM=Watson's <your-gmail-address@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-google-app-password

# Optional migration inputs for npm run migrate:menu-descriptions.
MENU_DESCRIPTION_FILE=
MENU_DESCRIPTION_MENU_TITLE=
MENU_DESCRIPTION_REMOVE_ITEM_JSON=
